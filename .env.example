# Copiá este archivo como .env y completá los valores

# URL del backend. Vacío: en desarrollo usa staging y en un build de producción,
# https://nombre-proyecto-back-production.up.railway.app
EXPO_PUBLIC_API_URL=

# Modo desarrollo (usuarios de prueba, sin backend). Apagado por defecto:
# solo se prende con 'true'. Nunca en un build para usuarios.
EXPO_PUBLIC_DEV_MODE=

# Google Maps API — para MapView (Android)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places New API — Google Cloud Console → APIs → Places API (New) → Credentials
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# Firebase — Firebase Console → Settings → Tu app web → firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
