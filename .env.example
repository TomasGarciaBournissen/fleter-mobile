# Copiá este archivo como .env y completá los valores

# URL del backend (usá la IP de tu PC en la red local para dispositivo físico)
EXPO_PUBLIC_API_URL=

# Dev mode — ponelo en 'false' para usar Firebase real
EXPO_PUBLIC_DEV_MODE=

# Google Places API — Google Cloud Console → APIs → Places API → Credentials
# Necesita Places API habilitada y restricción de plataforma (Android + iOS)
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# Firebase — Firebase Console → Settings → Tu app web → firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
