{
  "expo": {
    "name": "fleter-mobile",
    "slug": "fleter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.movix.fletermobile",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyDpWEEvdenhCI6cpSvG4Kj3qnITIFDYn04"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDpWEEvdenhCI6cpSvG4Kj3qnITIFDYn04"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Fleter necesita la cámara para escanear el código QR de entrega."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Fleter necesita tu ubicación para mostrar tu posición al cliente durante el viaje.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-font"
    ]
  }
}
